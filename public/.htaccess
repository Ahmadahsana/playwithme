# ── PlayWithMe · static deploy (Apache / cPanel) ──────────────────────────────
# Diletakkan otomatis di root output oleh `nuxt generate`.

# ── Paksa HTTPS ──────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Routing untuk situs prerender Nuxt ───────────────────────────────────────
# 1. File / folder yang benar-benar ada -> dilayani apa adanya.
# 2. "/about" -> "/about/index.html" (halaman sudah dibuat saat generate).
# 3. Path tak dikenal -> 200.html (fallback SPA, biar navigasi client tetap jalan).
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ /$1/index.html [L]

  RewriteRule ^ /200.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ── Kompresi ────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>

# ── Cache ───────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Aset ber-hash di /_nuxt/ tidak pernah berubah isinya -> cache selamanya.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 30 days"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML & payload harus selalu segar supaya update situs langsung terlihat.
  <FilesMatch "\.(html|json)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Keamanan dasar ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
